---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingList from '../components/WritingList.astro';
import Icon from '../components/Icon.astro';
import { getPosts, getProjects } from '../lib/content';
import { site } from '../data/site';
const projects = (await getProjects()).filter(({ data }) => data.selected);
const posts = (await getPosts()).slice(0, 3);
---
<BaseLayout>
  <div class="shell">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow hero-kicker"><span class="accent-dot"></span>PERSONAL ENGINEERING NOTEBOOK</p>
        <h1 id="intro-title"><span class="hero-chinese">王一帆<span class="name-slash"> /</span></span><span class="hero-english">Wang Yifan<span class="accent-text">.</span></span></h1>
        <p class="hero-major">Measurement &amp; Control Engineering</p>
        <p class="hero-school">{site.university}</p>
        <p class="hero-interests">Embedded Systems <span>·</span> Control <span>·</span> Robotics</p>
        <div class="hero-actions"><a class="button button-primary" href="/projects/">View Projects <Icon name="arrow" size={16} /></a><a class="button button-secondary" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={15} /></a></div>
      </div>
      <aside class="focus-panel" aria-label="技术方向">
        <div class="panel-heading"><span class="eyebrow">AREAS OF INTEREST</span><span class="crosshair" aria-hidden="true">+</span></div>
        <div class="focus-row"><span class="mono">01</span><div><h2>Embedded Systems</h2><p>嵌入式系统 · STM32</p></div><span class="focus-symbol" aria-hidden="true">[ ]</span></div>
        <div class="focus-row"><span class="mono">02</span><div><h2>Control &amp; Robotics</h2><p>控制系统 · 机器人</p></div><span class="focus-symbol" aria-hidden="true">↗</span></div>
        <div class="focus-row"><span class="mono">03</span><div><h2>Electronics &amp; Signals</h2><p>电子设计 · 信号处理</p></div><span class="focus-symbol" aria-hidden="true">∿</span></div>
        <div class="panel-foot mono">MEASURE / BUILD / UNDERSTAND</div>
      </aside>
    </section>
    <section class="home-section" aria-labelledby="projects-heading">
      <div class="section-heading"><div><p class="eyebrow">01 / ENGINEERING</p><h2 id="projects-heading">Selected Projects</h2><p>从嵌入式软件到电子硬件，记录工程实践。</p></div><a class="text-link" href="/projects/">All projects <Icon name="arrow" size={16} /></a></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">{projects.map((project) => <ProjectCard project={project} />)}</div>
    </section>
    <section class="home-section writing-section" aria-labelledby="writing-heading">
      <div class="section-heading"><div><p class="eyebrow">02 / FIELD NOTES</p><h2 id="writing-heading">Latest Writing</h2><p>技术笔记、设计过程与学习记录。</p></div><a class="text-link" href="/blog/">All writing <Icon name="arrow" size={16} /></a></div>
      <WritingList posts={posts} />
    </section>
    <aside class="home-about"><p>关于工程，也关于学习。<span>这里是我的项目档案与技术笔记。</span></p><a class="text-link" href="/about/">More about me <Icon name="arrow" size={16} /></a></aside>
  </div>
</BaseLayout>
