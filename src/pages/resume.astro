---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getProjects } from '../lib/content';
const projects = await getProjects();
---
<BaseLayout title="Resume / Academic profile">
  <div class="shell page-space resume-page">
    <header class="page-heading"><p class="eyebrow">ACADEMIC PROFILE</p><h1>王一帆 <span class="resume-en">/ Wang Yifan</span></h1><p>教育背景与项目目录</p><button class="button button-secondary print-button" hidden>打印 / 保存 PDF</button></header>
    <section class="resume-section"><h2>Education</h2><div><h3>{site.universityZh}</h3><p>{site.university}</p><p>{site.majorZh}<br />{site.major}</p><p class="muted">就读时间与其他教育信息待补充。</p></div></section>
    <section class="resume-section"><h2>Interests</h2><div class="flex flex-wrap gap-2">{site.interests.map((interest) => <span class="tag">{interest}</span>)}</div></section>
    <section class="resume-section"><h2>Projects</h2><div class="resume-projects">{projects.map((project) => <div><h3><a href={`/projects/${project.id}/`}>{project.data.titleZh}</a></h3><p>{project.data.title}</p></div>)}<p class="muted">项目职责、时间与成果待补充；此页面仅列出已提供的信息。</p></div></section>
    <section class="resume-section"><h2>Contact</h2><div><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">github.com/uestc-wangyifan ↗</a><p class="muted">{site.email || 'Email · 待补充'}</p></div></section>
  </div>
</BaseLayout>
<script>const print = document.querySelector<HTMLButtonElement>('.print-button'); if (print) { print.hidden = false; print.addEventListener('click', () => window.print()); }</script>
