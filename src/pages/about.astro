---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<BaseLayout title="About">
  <div class="shell page-space">
    <header class="page-heading"><p class="eyebrow">ABOUT / 王一帆</p><h1>Wang Yifan<span class="accent-text">.</span></h1><p>测控技术与仪器 · 电子科技大学</p></header>
    <div class="about-grid"><section class="prose"><h2>关于我</h2><p>我是王一帆，就读于电子科技大学，专业为测控技术与仪器。</p><p>我的主要技术方向包括嵌入式系统、控制系统、机器人、电子设计、STM32、PCB 设计与信号处理。</p><p>这个网站用于长期整理工程项目、技术博客与学习笔记。项目档案将逐步补充硬件、软件、设计过程和验证资料。</p><h2>Technical interests</h2><ul class="interest-list">{site.interests.map((interest) => <li>{interest}</li>)}</ul><h2>On this site</h2><p><a href="/projects/">Projects</a> 收录工程项目；<a href="/blog/">Blog</a> 用于技术写作与学习记录。所有标记为「示例」的文章仅展示内容格式。</p></section>
      <aside class="profile-facts"><p class="eyebrow">PROFILE</p><dl><dt>Name</dt><dd>王一帆 / Wang Yifan</dd><dt>University</dt><dd>{site.universityZh}<span>{site.university}</span></dd><dt>Major</dt><dd>{site.majorZh}<span>{site.major}</span></dd></dl><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={15} /></a><a class="text-link" href="/resume/">Academic profile <Icon name="arrow" size={15} /></a></aside>
    </div>
  </div>
</BaseLayout>
